---
/**
 * Platform-first marketing hero (2026-10 rewrite).
 *
 * tournamental.com is about the platform: predictions for every match,
 * pools for any crew, the bracket bot, leaderboards, and verifiable
 * picks committed before kickoff, across tournaments. The side card
 * carries whatever is coming next (right now Rugby World Cup 2027)
 * and the register-interest CTA into play.tournamental.com. Finished
 * tournaments live in the archive.
 *
 * Inherits editorial tokens from globals.css (gold accent, opsz axis,
 * hairline rules, choreographed reveal). Motion gates on
 * `prefers-reduced-motion`.
 */
const NEXT_KICKER = "Coming next · 1 Oct to 13 Nov 2027";
const HEADLINE_LINE_1 = "We Game-ify";
const HEADLINE_LINE_2 = "the Tournament";

const platformHref = "/how-it-works";
const repoHref = "https://github.com/0800tim/tournamental";
const registerHref = "https://play.tournamental.com/#register";
const archiveHref = "https://fwc2026.tournamental.com";
---
<section class="vt-editorial vt-hero">
  <div class="container-page vt-hero-inner vt-hero-grid">
    <div class="vt-hero-main">
      <p class="vt-dateline" data-reveal="dateline">
        Tournamental &middot; Est. 2026 &middot; Apache 2.0
      </p>

      <h1 class="vt-headline mt-7" data-reveal="headline">
        <span class="vt-hero-line">{HEADLINE_LINE_1}</span>
        <span class="vt-hero-line">{HEADLINE_LINE_2}</span>
      </h1>

      <hr class="vt-rule mt-10" data-reveal="rule" aria-hidden="true" />

      <p class="vt-lede mt-8" data-reveal="lede">
        Tournamental turns a tournament into a game you play every day of it.
        Predict every match, change any call right up to kickoff, and climb a
        <strong>global leaderboard</strong> that settles as the results land.
        Run a pool for your club, your office, your creator audience or your
        group chat, with your name on it.
      </p>

      <p class="vt-lede mt-6" data-reveal="lede">
        Every pick is committed to a <strong>public ledger</strong> before the
        whistle, so a claim to glory is finally provable. The bracket bot keeps
        your crew in the game between matches. The same platform runs every
        tournament, and keeps the finished ones in the archive.
      </p>

      <div class="vt-hero-cta-row mt-12 md:mt-14" data-reveal="cta">
        <a class="vt-cta-primary" href={platformHref} data-analytics="cta" data-analytics-label="How it works" data-analytics-surface="hero">
          How it works <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="vt-cta-text" href={repoHref} data-analytics="cta" data-analytics-label="View the repo" data-analytics-surface="hero">
          View the repo
        </a>
      </div>

      <p class="vt-footnote mt-10" data-reveal="footnote">
        Free to play &middot; Verifiable picks &middot; Contributors share platform revenue
      </p>
    </div>

    <aside class="vt-hero-next-card" data-reveal="wc-card" aria-labelledby="vt-hero-next-title">
      <img
        class="vt-hero-next-art"
        src="/rwc2027/hero.svg"
        width="1200"
        height="800"
        alt="Illustration: a gold and green rugby ball under the Southern Cross, with goal posts on a floodlit night pitch."
        loading="eager"
        decoding="async"
      />
      <p class="vt-hero-next-kicker">{NEXT_KICKER}</p>
      <h2 id="vt-hero-next-title" class="vt-hero-next-title">
        Rugby World Cup 2027™<br />
        in Australia
      </h2>
      <p class="vt-hero-next-body">
        Register your interest and be first in when picks open. Every match,
        pools for your crew, verifiable picks, free to play.
      </p>
      <a class="vt-hero-next-cta" href={registerHref} data-analytics="cta" data-analytics-label="Register interest RWC 2027" data-analytics-surface="hero">
        Register interest <span aria-hidden="true">&rarr;</span>
      </a>
      <ul class="vt-hero-next-meta" aria-hidden="true">
        <li><span>24</span>Teams</li>
        <li><span>52</span>Matches</li>
      </ul>
      <p class="vt-hero-next-archive">
        Looking for the last one? <a href={archiveHref}>FWC 2026 archive</a>
      </p>
    </aside>
  </div>
</section>

<style>
  .vt-hero {
    /* The hero opts out of the page-level radial-gradient body wash so
     * the type sits on a flat canvas. The rest of the page keeps the
     * existing background glow; only this section drops it. */
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .vt-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--vt-bg);
    z-index: -1;
  }

  .vt-hero-inner {
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .vt-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .vt-hero-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(300px, 400px);
      gap: 3.5rem;
    }
  }

  /* Stack the three headline lines so each rises individually. */
  .vt-hero-line {
    display: block;
  }

  .vt-hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  /* "Coming next" side card: the explicit cross-link to the play app
   * that earns its own prominent slot in the hero. Gold border, dark
   * card, original hero art on top, a bigger CTA than the platform's
   * how-it-works link so a casual visitor sees "right, where do I
   * register?" within the first scroll. */
  .vt-hero-next-card {
    background: linear-gradient(180deg, rgba(245, 197, 66, 0.06) 0%, rgba(245, 197, 66, 0.0) 60%), rgba(28, 28, 34, 0.85);
    border: 1px solid rgba(245, 197, 66, 0.35);
    border-radius: 18px;
    padding: clamp(20px, 2.5vw, 32px);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 20px 60px -28px rgba(245, 197, 66, 0.4);
  }

  .vt-hero-next-art {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 0 0 18px;
    border: 1px solid rgba(245, 197, 66, 0.18);
  }

  .vt-hero-next-archive {
    margin: 16px 0 0;
    font-size: 13px;
    line-height: 1.4;
    color: rgba(205, 213, 231, 0.7);
  }
  .vt-hero-next-archive a {
    color: #fbbf24;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .vt-hero-next-kicker {
    margin: 0 0 12px;
    font: 700 11px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fbbf24;
  }

  .vt-hero-next-title {
    margin: 0 0 14px;
    font-family: "Fraunces", ui-serif, Charter, Georgia, Cambria, "Times New Roman", serif;
    font-variation-settings: "opsz" 96;
    font-weight: 500;
    letter-spacing: -0.01em;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.05;
    color: #ffffff;
  }

  .vt-hero-next-body {
    margin: 0 0 22px;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(231, 234, 243, 0.78);
  }

  .vt-hero-next-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 14px 22px;
    min-height: 52px;
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    color: #15151a;
    border-radius: 999px;
    font: 800 16px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 12px 32px -10px rgba(245, 197, 66, 0.55);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .vt-hero-next-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 36px -10px rgba(245, 197, 66, 0.7);
  }

  .vt-hero-next-meta {
    list-style: none;
    padding: 18px 0 0;
    margin: 18px 0 0;
    border-top: 1px solid rgba(245, 197, 66, 0.18);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .vt-hero-next-meta li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font: 600 11px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(205, 213, 231, 0.6);
  }
  .vt-hero-next-meta li span {
    display: inline-block;
    font-family: "Fraunces", ui-serif, Charter, Georgia, Cambria, "Times New Roman", serif;
    font-variation-settings: "opsz" 96;
    font-size: clamp(20px, 2.4vw, 28px);
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  /* Slightly tighter stat row spacing on the hero specifically. */
  .vt-editorial .vt-stat-num {
    line-height: 0.95;
  }
</style>
